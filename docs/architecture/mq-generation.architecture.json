  "cards": [
    {
      "dot": "cyan",
      "title": "최초 생성",
      "items": [
        "user_request 선택 · trim 후 1~200자",
        "접수 때 조건·취향·후보를 스냅샷 저장",
        "성공 시 새 가이드북·생성권 1개 차감"
      ]
    },
    {
      "dot": "violet",
      "title": "재생성",
      "items": [
        "최근 완료 입력 + 현재 일정 + 새 feedback",
        "원본 user_request는 이력만, 전송본에서 제외",
        "성공 시 같은 ID·버전 증가, 생성권 미차감"
      ]
    },
    {
      "dot": "amber",
      "title": "현재 발행 실패 처리",
      "items": [
        "브로커 오류는 Outbox 대기·2~60초 재발행",
        "손상 입력은 FAILED·재시도 불가",
        "최대 발행 횟수·대기 만료 정책은 미정"
      ]
    },
    {
      "dot": "rose",
      "title": "MQ 전환 미완료",
      "items": [
        "점선은 Consumer 후속 경로",
        "실행 시작 시각·타이머 연결 전 콜백 409",
        "Consumer 중단·DLQ→실패 통지는 미구현"
      ]
    }
  ]
