# Copy this file to .env.loadtest and fill in local development credentials.
# Never commit .env.loadtest.

TOUR_API_SERVICE_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=

# Local load-test callback placeholder. Do not use an operating environment secret.
AI_CALLBACK_TOKEN=loadtest-ai-callback-token

# Optional resource and load-test overrides
BACKEND_CPUS=2
BACKEND_MEMORY=2g
MYSQL_CPUS=2
MYSQL_MEMORY=2g
LOADTEST_MYSQL_PORT=3308
REDIS_CPUS=1
REDIS_MEMORY=512m
LOADTEST_REDIS_PORT=6380
PROMETHEUS_PORT=9090
LOAD_TEST_USER_COUNT=500
LOAD_TEST_CREDIT_BALANCE=100
LOAD_TEST_SESSION_PREFIX=k6-local-session-

# SSE load-test defaults
SSE_CONNECTION_COUNT=100
SSE_HOLD_SECONDS=120
SSE_STARTUP_WAIT_SECONDS=5
SSE_RECOVERY_WAIT_SECONDS=35
NOTIFICATION_SSE_MAX_CONNECTIONS_PER_MEMBER=5

# Web Push Outbox Worker load-test defaults
WEB_PUSH_OUTBOX_WORKER_ENABLED=true
WEB_PUSH_OUTBOX_POLL_INTERVAL_MILLIS=1000
WEB_PUSH_OUTBOX_BATCH_SIZE=50
WEB_PUSH_OUTBOX_LEASE=1m
WEB_PUSH_OUTBOX_MAX_ATTEMPTS=3
WEB_PUSH_OUTBOX_INITIAL_BACKOFF=5s
WEB_PUSH_OUTBOX_MAX_BACKOFF=30s
WEB_PUSH_LOAD_TEST_GATEWAY_ENABLED=true
WEB_PUSH_LOAD_TEST_DELAYED_PERCENT=0
WEB_PUSH_LOAD_TEST_RETRY_429_PERCENT=0
WEB_PUSH_LOAD_TEST_RETRY_503_PERCENT=0
WEB_PUSH_LOAD_TEST_TIMEOUT_PERCENT=0
WEB_PUSH_LOAD_TEST_DELAY=200ms
WEB_PUSH_LOAD_TEST_TIMEOUT=2s
