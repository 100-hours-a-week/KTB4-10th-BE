discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "backend_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_observability_logs"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "backend" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.backend_logs.rules
  labels        = { environment = "local-loadtest" }
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
